filters:
  and:
    - file.folder.contains("NPCs")
    - '!file.name.endsWith("base")'
properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: NPC Table
    order:
      - file.name
      - Location
      - Appearances
      - Role
      - tags
    sort:
      - property: file.name
        direction: ASC
      - property: Location
        direction: ASC
