views:
  - type: cards
    name: Table
    filters:
      and:
        - file.folder == "Selerim Wiki/Adventures"
    order:
      - file.name
      - DM
      - Setting
      - In-World Start Date
      - In-World End Date
      - Players
    sort:
      - property: Start Date
        direction: DESC
    summaries:
      Sessions: Sum
    columnSize:
      note.Sessions: 101
      note.Races: 635
    cardSize: 800
    image: note.image
    imageFit: contain
    imageAspectRatio: 0.25
