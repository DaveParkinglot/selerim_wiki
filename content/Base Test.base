views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "Selerim Wiki/Adventures"
    order:
      - file.name
      - DM
      - In-World Start Date
      - In-World End Date
      - Start Date
      - End Date
      - Setting
      - Sessions
      - Platform
      - Players
      - Characters
      - Classes
      - Races
    sort:
      - property: Sessions
        direction: DESC
    summaries:
      Sessions: Sum
    columnSize:
      note.Sessions: 101
      note.Races: 635
