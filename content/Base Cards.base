views:
  - type: cards
    name: Cards
    filters:
      or:
        - file.path.startsWith("Selerim Wiki/World Overview")
        - file.path.startsWith("Selerim Wiki/Selerim Timeline")
        - file.name == "Adventure Log"
    order:
      - file.name
    sort:
      - property: file.name
        direction: DESC
    image: note.image
    imageAspectRatio: 0.5
    cardSize: 160
    imageFit: contain
  - type: table
    name: View
